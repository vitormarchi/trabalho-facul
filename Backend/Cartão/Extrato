{
  "name": "bank-card-backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.22"
  }
}
// BACKEND - API DE CARTÃO E EXTRATO
// Autor: Vitor Galdino Marchi

const express = require('express');
const cors = require('cors');
const fs = require('fs');
const { v4: uuidv4 } = require('uuid');

const app = express();
app.use(cors());
app.use(express.json());

const DATA_FILE = './data.json';

// Funções auxiliares
function readData() {
  if (!fs.existsSync(DATA_FILE)) {
    fs.writeFileSync(DATA_FILE, JSON.stringify({ transactions: [] }));
  }
  return JSON.parse(fs.readFileSync(DATA_FILE, 'utf-8'));
}
function saveData(data) {
  fs.writeFileSync(DATA_FILE, JSON.stringify(data, null, 2));
}

// Rota: listar transações
app.get('/transactions', (req, res) => {
  const data = readData();
  res.json(data.transactions);
});

// Rota: adicionar transação
app.post('/transactions', (req, res) => {
  const { description, amount, date, category } = req.body;
  if (!description || !amount || !date)
    return res.status(400).json({ error: 'Campos obrigatórios: description, amount e date.' });

  const data = readData();
  const newTx = {
    id: uuidv4(),
    description,
    amount: parseFloat(amount),
    date,
    category: category || 'Outros',
    type: amount >= 0 ? 'credit' : 'debit'
  };

  data.transactions.push(newTx);
  saveData(data);
  res.status(201).json(newTx);
});

// Rota: resumo (saldo total)
app.get('/summary', (req, res) => {
  const { transactions } = readData();
  const totalCredit = transactions.filter(t => t.amount > 0).reduce((s, t) => s + t.amount, 0);
  const totalDebit = transactions.filter(t => t.amount < 0).reduce((s, t) => s + Math.abs(t.amount), 0);
  const balance = totalCredit - totalDebit;
  res.json({ balance, totalCredit, totalDebit });
});

// Rota: exportar CSV
app.get('/export', (req, res) => {
  const { transactions } = readData();
  const csv = 'id,date,description,amount,category,type\n' + 
    transactions.map(t => `${t.id},${t.date},"${t.description}",${t.amount},${t.category},${t.type}`).join('\n');

  res.setHeader('Content-Type', 'text/csv');
  res.setHeader('Content-Disposition', 'attachment; filename="extrato.csv"');
  res.send(csv);
});

// Porta
const PORT = 4000;
app.listen(PORT, () => console.log(`✅ Servidor rodando em http://localhost:${PORT}`));
